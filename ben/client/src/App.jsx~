import React, { useState } from 'react';
import { motion, AnimatePresence } from 'framer-motion';
import { Crown, Sparkles, Lock, Mail, User, Shield, Compass, LogOut, ArrowRight } from 'lucide-react';
import axios from 'axios';

const API_URL = 'http://localhost:5000/api/auth';

export default function App() {
  const [step, setStep] = useState('splash'); // splash, auth, transition, dashboard
  const [isLogin, setIsLogin] = useState(true);
  const [user, setUser] = useState(null);
  const [formData, setFormData] = useState({ name: '', email: '', password: '' });
  const [error, setError] = useState('');
  const [loading, setLoading] = useState(false);

  // Gestion des champs de formulaire
  const handleChange = (e) => {
    setFormData({ ...formData, [e.target.name]: e.target.value });
  };

  // Soumission Authentification (Login / Register)
  const handleSubmit = async (e) => {
    e.preventDefault();
    setError('');
    setLoading(true);

    try {
      const endpoint = isLogin ? '/login' : '/register';
      const response = await axios.post(`${API_URL}${endpoint}`, formData);
      
      setUser(response.data.user);
      localStorage.setItem('token', response.data.token);
      
      // Passage à l'animation de transition avant le dashboard
      setStep('transition');
      setTimeout(() => {
        setStep('dashboard');
      }, 3500);
    } catch (err) {
      setError(err.response?.data?.message || 'Une erreur est survenue.');
    } finally {
      setLoading(false);
    }
  };

  const handleLogout = () => {
    localStorage.removeItem('token');
    setUser(null);
    setStep('auth');
  };

  return (
    <div className="min-h-screen bg-[#0A0A0C] text-[#F3E5AB] flex items-center justify-center relative overflow-hidden font-sans">
      {/* Arrière-plan Ambiance Dorée/Bronze */}
      <div className="absolute top-[-20%] left-[-10%] w-[500px] h-[500px] bg-gradient-to-br from-[#D4AF37]/15 to-[#CD7F32]/5 rounded-full blur-[120px] pointer-events-none" />
      <div className="absolute bottom-[-20%] right-[-10%] w-[500px] h-[500px] bg-gradient-to-tl from-[#1A1412]/80 to-[#D4AF37]/10 rounded-full blur-[120px] pointer-events-none" />

      <AnimatePresence mode="wait">
        {/* ÉCRAN 1 : ANIMATION DE BIENVENUE INITIALE (SPLASH) */}
        {step === 'splash' && (
          <motion.div
            key="splash"
            initial={{ opacity: 0 }}
            animate={{ opacity: 1 }}
            exit={{ opacity: 0, scale: 0.95 }}
            transition={{ duration: 1 }}
            className="flex flex-col items-center justify-center text-center p-8 z-10 max-w-md"
          >
            <motion.div
              initial={{ scale: 0, rotate: -180 }}
              animate={{ scale: 1, rotate: 0 }}
              transition={{ duration: 1.2, type: 'spring' }}
              className="w-24 h-24 rounded-full bg-gradient-to-tr from-[#1A1412] via-[#D4AF37] to-[#CD7F32] p-[2px] shadow-[0_0_50px_rgba(212,175,55,0.3)] mb-6"
            >
              <div className="w-full h-full bg-[#0A0A0C] rounded-full flex items-center justify-center">
                <Crown className="w-12 h-12 text-[#D4AF37]" />
              </div>
            </motion.div>

            <motion.h1
              initial={{ y: 20, opacity: 0 }}
              animate={{ y: 0, opacity: 1 }}
              transition={{ delay: 0.4 }}
              className="text-4xl font-serif font-bold tracking-widest bg-gradient-to-r from-[#F3E5AB] via-[#D4AF37] to-[#CD7F32] bg-clip-text text-transparent uppercase mb-2"
            >
              AURA
            </motion.h1>

            <motion.p
              initial={{ y: 20, opacity: 0 }}
              animate={{ y: 0, opacity: 1 }}
              transition={{ delay: 0.6 }}
              className="text-sm tracking-widest text-[#D4AF37]/70 uppercase mb-8"
            >
              L'Excellence & Le Luxe Sur Mesure
            </motion.p>

            <motion.button
              initial={{ y: 20, opacity: 0 }}
              animate={{ y: 0, opacity: 1 }}
              transition={{ delay: 0.8 }}
              whileHover={{ scale: 1.05 }}
              whileTap={{ scale: 0.95 }}
              onClick={() => setStep('auth')}
              className="px-8 py-3 rounded-full bg-gradient-to-r from-[#D4AF37] to-[#CD7F32] text-[#0A0A0C] font-semibold tracking-wider flex items-center gap-2 shadow-[0_0_20px_rgba(212,175,55,0.4)]"
            >
              Entrer dans le Club <ArrowRight className="w-4 h-4" />
            </motion.button>
          </motion.div>
        )}

        {/* ÉCRAN 2 : CONNEXION / INSCRIPTION */}
        {step === 'auth' && (
          <motion.div
            key="auth"
            initial={{ opacity: 0, y: 30 }}
            animate={{ opacity: 1, y: 0 }}
            exit={{ opacity: 0, y: -30 }}
            transition={{ duration: 0.8 }}
            className="w-full max-w-md p-8 rounded-2xl bg-[#1A1412]/40 border border-[#D4AF37]/20 backdrop-blur-xl shadow-2xl z-10"
          >
            <div className="text-center mb-8">
              <Crown className="w-10 h-10 text-[#D4AF37] mx-auto mb-2" />
              <h2 className="text-2xl font-serif text-[#D4AF37]">
                {isLogin ? 'Espace Membre' : 'Rejoindre l\'Élite'}
              </h2>
              <p className="text-xs text-[#CD7F32] tracking-wider mt-1">
                {isLogin ? 'Veuillez vous identifier' : 'Créer votre accès exclusif'}
              </p>
            </div>

            {error && (
              <div className="mb-4 p-3 rounded bg-red-900/30 border border-red-500/50 text-red-300 text-xs text-center">
                {error}
              </div>
            )}

            <form onSubmit={handleSubmit} className="space-y-4">
              {!isLogin && (
                <div className="relative">
                  <User className="absolute left-3 top-3 w-5 h-5 text-[#D4AF37]/50" />
                  <input
                    type="text"
                    name="name"
                    placeholder="Nom complet"
                    value={formData.name}
                    onChange={handleChange}
                    required
                    className="w-full bg-[#0A0A0C]/80 border border-[#D4AF37]/30 rounded-lg py-2.5 pl-10 pr-4 text-sm text-[#F3E5AB] focus:outline-none focus:border-[#D4AF37]"
                  />
                </div>
              )}

              <div className="relative">
                <Mail className="absolute left-3 top-3 w-5 h-5 text-[#D4AF37]/50" />
                <input
                  type="email"
                  name="email"
                  placeholder="Adresse Email"
                  value={formData.email}
                  onChange={handleChange}
                  required
                  className="w-full bg-[#0A0A0C]/80 border border-[#D4AF37]/30 rounded-lg py-2.5 pl-10 pr-4 text-sm text-[#F3E5AB] focus:outline-none focus:border-[#D4AF37]"
                />
              </div>

              <div className="relative">
                <Lock className="absolute left-3 top-3 w-5 h-5 text-[#D4AF37]/50" />
                <input
                  type="password"
                  name="password"
                  placeholder="Mot de passe"
                  value={formData.password}
                  onChange={handleChange}
                  required
                  className="w-full bg-[#0A0A0C]/80 border border-[#D4AF37]/30 rounded-lg py-2.5 pl-10 pr-4 text-sm text-[#F3E5AB] focus:outline-none focus:border-[#D4AF37]"
                />
              </div>

              <button
                type="submit"
                disabled={loading}
                className="w-full py-3 mt-4 rounded-lg bg-gradient-to-r from-[#D4AF37] to-[#CD7F32] text-[#0A0A0C] font-bold text-sm tracking-widest uppercase hover:brightness-110 transition shadow-[0_0_15px_rgba(212,175,55,0.3)] disabled:opacity-50"
              >
                {loading ? 'Traitement...' : isLogin ? 'Se Connecter' : 'S\'Inscrire'}
              </button>
            </form>

            <div className="mt-6 text-center">
              <button
                onClick={() => { setIsLogin(!isLogin); setError(''); }}
                className="text-xs text-[#D4AF37]/80 hover:text-[#F3E5AB] transition underline"
              >
                {isLogin ? 'Pas encore membre ? Créez un compte' : 'Déjà membre ? Connexion'}
              </button>
            </div>
          </motion.div>
        )}

        {/* ÉCRAN 3 : ANIMATION DE TRANSITION POST-CONNEXION */}
        {step === 'transition' && (
          <motion.div
            key="transition"
            initial={{ opacity: 0, scale: 0.8 }}
            animate={{ opacity: 1, scale: 1 }}
            exit={{ opacity: 0, scale: 1.1 }}
            transition={{ duration: 1 }}
            className="text-center z-10"
          >
            <motion.div
              animate={{ rotate: 360 }}
              transition={{ duration: 2, repeat: Infinity, ease: 'linear' }}
              className="w-20 h-20 border-2 border-t-[#D4AF37] border-r-[#CD7F32] border-b-[#1A1412] border-l-transparent rounded-full mx-auto mb-6"
            />
            <motion.h2
              initial={{ opacity: 0, y: 10 }}
              animate={{ opacity: 1, y: 0 }}
              transition={{ delay: 0.5 }}
              className="text-2xl font-serif text-[#F3E5AB]"
            >
              Bienvenue, {user?.name || 'Initié'}
            </motion.h2>
            <motion.p
              initial={{ opacity: 0 }}
              animate={{ opacity: 1 }}
              transition={{ delay: 1 }}
              className="text-xs text-[#D4AF37] tracking-widest mt-2 uppercase"
            >
              Préparation de votre univers privé...
            </motion.p>
          </motion.div>
        )}

        {/* ÉCRAN 4 : TABLEAU DE BORD PRINCIPAL */}
        {step === 'dashboard' && (
          <motion.div
            key="dashboard"
            initial={{ opacity: 0 }}
            animate={{ opacity: 1 }}
            transition={{ duration: 1 }}
            className="w-full max-w-4xl p-6 z-10"
          >
            {/* Header */}
            <div className="flex items-center justify-between border-b border-[#D4AF37]/20 pb-6 mb-8">
              <div className="flex items-center gap-3">
                <Crown className="w-8 h-8 text-[#D4AF37]" />
                <div>
                  <h1 className="text-xl font-serif text-[#F3E5AB]">{user?.name}</h1>
                  <span className="text-xs text-[#CD7F32] tracking-widest uppercase">Membre Privilège</span>
                </div>
              </div>

              <button
                onClick={handleLogout}
                className="flex items-center gap-2 px-4 py-2 rounded-lg bg-[#1A1412] border border-[#D4AF37]/30 text-xs text-[#D4AF37] hover:bg-[#D4AF37] hover:text-[#0A0A0C] transition"
              >
                <LogOut className="w-4 h-4" /> Déconnexion
              </button>
            </div>

            {/* Cartes de Fonctionnalités */}
            <div className="grid grid-cols-1 md:grid-cols-3 gap-6">
              {[
                { icon: Shield, title: "Coffre Privé", desc: "Vos actifs et avantages sécurisés" },
                { icon: Compass, title: "Services Concierge", desc: "Assistance dédiée 24/7" },
                { icon: Sparkles, title: "Événements VIP", desc: "Invitations exclusives réservées" }
              ].map((item, idx) => (
                <motion.div
                  key={idx}
                  whileHover={{ y: -5 }}
                  className="p-6 rounded-xl bg-[#1A1412]/50 border border-[#D4AF37]/20 backdrop-blur"
                >
                  <item.icon className="w-8 h-8 text-[#D4AF37] mb-4" />
                  <h3 className="text-lg font-serif text-[#F3E5AB] mb-2">{item.title}</h3>
                  <p className="text-xs text-[#D4AF37]/70">{item.desc}</p>
                </motion.div>
              ))}
            </div>
          </motion.div>
        )}
      </AnimatePresence>
    </div>
  );
}

export default App
